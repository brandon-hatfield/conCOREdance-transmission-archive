{
  "source_root": "~/Library/CloudStorage/GoogleDrive-brandon.hatfield@seekingharmony.net/My Drive/ConCOREdance",
  "repo_root": "{REPO_ROOT}",
  "mappings": [
    {
      "source": "README_UPLOAD_INSTRUCTIONS.md",
      "target": "README_UPLOAD_INSTRUCTIONS.md"
